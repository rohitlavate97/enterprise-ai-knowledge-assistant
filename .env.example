# ==============================================================================
# Enterprise AI Knowledge Assistant Configuration Template
# Copy this file to '.env' and fill in your local/production values.
# ==============================================================================

# Core Application Settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Security & Authentication
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=supersecretjwtkeyplaceholderchangeinproduction
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Relational Database (MySQL 8.4 LTS)
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/knowledge_assistant

# Caching & Session Storage (Redis)
REDIS_URL=redis://localhost:6379/0

# Message Broker & Task Queue (RabbitMQ / Celery)
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# LLM Providers (OpenAI is default, supports others)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Human-in-the-loop Notification Channels
NOTIFICATION_EMAIL_SENDER=no-reply@enterprise.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
